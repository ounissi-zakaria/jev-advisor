{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext"],
		"module": "Preserve",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"exactOptionalPropertyTypes": false,
		"skipLibCheck": true,
		"types": ["bun"]
	},
	"include": ["src"]
}
